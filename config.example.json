{
  "addr": "127.0.0.1:7777",
  "repos": [
    {"path": "~/code/my-app", "base_branch": "main"},
    {"path": "~/code/other-repo", "base_branch": "develop"}
  ],
  "session_max_age_days": 14,
  "editor_command": ["code"],
  "sessions_refresh_seconds": 3,
  "github_review_query": "is:pr is:open review-requested:@me archived:false",
  "notion": {
    "database_id": "0123456789abcdef0123456789abcdef",
    "user_id": "00000000-0000-0000-0000-000000000000",
    "assignee_property": "Assignee",
    "priority_property": "Priority",
    "token_command": ["security", "find-generic-password", "-s", "devboard-notion", "-w"],
    "open_in_app": true
  }
}
